# syntax=docker/dockerfile:1.7

ARG GO_IMAGE
ARG RUNTIME_IMAGE
FROM ${GO_IMAGE} AS build

WORKDIR /src
COPY runtime/deploy/temporal/app/go.mod runtime/deploy/temporal/app/go.sum ./
RUN go mod download
COPY runtime/deploy/temporal/app/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/starter ./cmd/starter

FROM ${RUNTIME_IMAGE}

ARG GIT_REVISION
ARG SOURCE_SHA256
ARG GO_IMAGE
ARG RUNTIME_IMAGE
ARG TEMPORAL_SAMPLES_COMMIT
ARG TEMPORAL_GO_SDK_VERSION
LABEL org.opencontainers.image.title="safe-change Temporal workflow starter" \
      org.opencontainers.image.source="https://github.com/eunomia-bpf/agent-check-restore-safety" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.base.name="${RUNTIME_IMAGE}" \
      io.safe-change.source.sha256="${SOURCE_SHA256}" \
      io.safe-change.build.target="starter" \
      io.safe-change.builder.base="${GO_IMAGE}" \
      io.safe-change.temporal.samples.revision="${TEMPORAL_SAMPLES_COMMIT}" \
      io.safe-change.temporal.go-sdk.version="${TEMPORAL_GO_SDK_VERSION}"
COPY --from=build --chmod=0555 /out/starter /usr/local/bin/starter
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/starter"]
