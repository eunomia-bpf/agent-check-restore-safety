+import axios from "axios";
+import { readFileSync } from "node:fs";
+
+type RuntimeOutcome = {
+  phase: string;
+  body?: string;
+};
+
+type OperationReceipt = {
+  schema: number;
+  outcome: string;
+};
+
+function requiredEnvironment(name: string): string {
+  const value = process.env[name];
+  if (value === undefined || value.length === 0) {
+    throw new Error(`Missing required environment variable ${name}`);
+  }
+  return value;
+}
+
+const CONTROL_URL = requiredEnvironment("SAFE_CHANGE_CONTROL_URL").replace(/\/+$/, "");
+const PAYMENT_KIND = requiredEnvironment("SAFE_CHANGE_PAYMENT_KIND");
+const PAYMENT_TARGET = requiredEnvironment("SAFE_CHANGE_PAYMENT_TARGET");
+const OPERATION_TOKEN = readFileSync(
+  requiredEnvironment("SAFE_CHANGE_OPERATION_TOKEN_FILE"),
+  "utf8",
+).trim();
+
+if (OPERATION_TOKEN.length < 32) {
+  throw new Error("Operation token must contain at least 32 bytes");
+}
