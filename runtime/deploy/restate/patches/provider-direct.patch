+ *
+ * This file is part of the Restate examples,
+ * which is released under the MIT license.
+ *
+ * You can find a copy of the license in the file LICENSE
+ * in the root directory of this repository or package or at
+ * https://github.com/restatedev/examples/
+ */
+
+import axios from "axios";
+import { createHash } from "node:crypto";
+
+type OperationReceipt = {
+  schema: number;
+  operation_id: string;
+  outcome: string;
+  result_hash: string;
+  remote_reference: string;
+};
+
+function requiredEnvironment(name: string): string {
+  const value = process.env[name];
+  if (value === undefined || value.length === 0) {
+    throw new Error(`Missing required environment variable ${name}`);
+  }
+  return value;
+}
+
+const COMPLETION_ENDPOINT = requiredEnvironment("COMPLETION_ENDPOINT");
+const OPERATION_DOMAIN = requiredEnvironment("OPERATION_DOMAIN");
+
+function operationId(callId: string): string {
+  const digest = createHash("sha256");
+  digest.update("operation-id-v1\0", "utf8");
+  digest.update(OPERATION_DOMAIN, "utf8");
+  digest.update("\0", "utf8");
+  digest.update(callId, "utf8");
+  return `op-${digest.digest("hex")}`;
+}
+
+class CompletionClient {
+  async complete(id: string): Promise<boolean> {
+    console.info(`[${id}] Recording terminal delivery`);
+    const identity = operationId(`order/${id}/completion`);
+    const body = Buffer.from(JSON.stringify({ order_id: id, status: "DELIVERED" }), "utf8");
+    const response = await axios.post<OperationReceipt>(COMPLETION_ENDPOINT, body, {
+      headers: {
+        "Content-Type": "application/json",
+        "Idempotency-Key": identity,
+        "X-Operation-ID": identity,
+      },
+      timeout: 0,
+    });
+    if (
+      response.data.schema !== 1 ||
+      response.data.operation_id !== identity ||
+      response.data.outcome !== "succeeded" ||
+      typeof response.data.result_hash !== "string" ||
+      typeof response.data.remote_reference !== "string"
+    ) {
+      throw new Error("Completion provider returned an invalid receipt");
+    }
+    return true;
+  }
+}
+
+export function getCompletionClient() {
+  return new CompletionClient();
+}
