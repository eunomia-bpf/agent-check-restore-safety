{
  "arguments": [
    "-name",
    "safe-change-full-agent-vm",
    "-machine",
    "q35",
    "-m",
    "2048",
    "-smp",
    "2",
    "-drive",
    "file=<host-sandbox-socket>,if=virtio,format=qcow2,cache=none",
    "-display",
    "none",
    "-serial",
    "file:<vm-evidence>/guest.serial.log",
    "-monitor",
    "none",
    "-qmp",
    "unix:<host-sandbox-socket>/qmp.sock,server=on,wait=off",
    "-no-reboot",
    "-nic",
    "none",
    "-netdev",
    "user,id=agentnet,restrict=on,guestfwd=tcp:10.0.2.100:8000-cmd:/usr/bin/nc.openbsd 127.0.0.1 56185,guestfwd=tcp:10.0.2.100:9000-cmd:/usr/bin/nc.openbsd 127.0.0.1 51739,guestfwd=tcp:10.0.2.100:8788-cmd:/usr/bin/nc.openbsd 127.0.0.1 48551",
    "-device",
    "virtio-net-pci,netdev=agentnet",
    "-smbios",
    "type=1,serial=ds=nocloud;s=http://10.0.2.100:8000/",
    "-accel",
    "kvm"
  ],
  "executable": "qemu-system-x86_64",
  "schema": 1
}
