{
  "arguments": [
    "-name",
    "safe-change-shared-history-vm",
    "-machine",
    "q35",
    "-m",
    "1024",
    "-smp",
    "2",
    "-drive",
    "file=<vm-evidence>/guest.qcow2,if=virtio,format=qcow2,cache=none",
    "-display",
    "none",
    "-serial",
    "file:<vm-evidence>/guest.serial.log",
    "-monitor",
    "none",
    "-qmp",
    "unix:<vm-evidence>/qmp.sock,server=on,wait=off",
    "-no-reboot",
    "-nic",
    "none",
    "-netdev",
    "user,id=opnet,restrict=on,guestfwd=tcp:10.0.2.100:8000-cmd:/usr/bin/nc.openbsd 127.0.0.1 38469,guestfwd=tcp:10.0.2.100:8787-cmd:/usr/bin/nc.openbsd -U <host-sandbox-socket>",
    "-device",
    "virtio-net-pci,netdev=opnet",
    "-smbios",
    "type=1,serial=ds=nocloud;s=http://10.0.2.100:8000/",
    "-accel",
    "kvm"
  ],
  "executable": "qemu-system-x86_64",
  "schema": 1
}
