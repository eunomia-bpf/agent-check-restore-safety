AuthorityContinuity.TypedHistoryAdmission.classifyAdmission_sound.{uU, uS, uD, uV} {U : Type uU} {S : Type uS}
  {D : Type uD} [Fintype U] [DecidableEq U] [Fintype S] [DecidableEq S] [Fintype D] [DecidableEq D] {Version : Type uV}
  [Preorder Version] {authority : Finset (Finset U)} (old : TypedHistoryAdmission.AdmittedEnvelope authority S Version)
  (op : TypedHistoryAdmission.HistoryOp D) (lineage : D → U) (targetVersion : Version) (opValid : op.Valid) :
  match TypedHistoryAdmission.HistoryOp.classifyAdmission old op lineage targetVersion with
  | TypedHistoryAdmission.AdmissionClass.inherit =>
    TypedHistoryAdmission.HistoryOp.CanInherit old op lineage targetVersion ∧
      op.required ⊆ TypedHistoryAdmission.HistoryOp.admittedFuture authority old.durable op lineage
  | TypedHistoryAdmission.AdmissionClass.readmitOK =>
    ¬TypedHistoryAdmission.HistoryOp.CanInherit old op lineage targetVersion ∧
      op.FullReadmit authority old.durable lineage ∧
        op.required ⊆ TypedHistoryAdmission.HistoryOp.admittedFuture authority old.durable op lineage
  | TypedHistoryAdmission.AdmissionClass.needsMechanism => op.NeedsMechanism authority old.durable lineage
  | TypedHistoryAdmission.AdmissionClass.reject => op.PruningReject authority old.durable lineage
